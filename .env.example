# Shop desk login. Choose a password and restart the server.
# The password is hashed in the database. It is not stored in git.
# It is applied only when that username does not exist yet.
# After that, change it from the desk. Restarting will not overwrite it.
ADMIN_USERNAME=mindy
ADMIN_PASSWORD=

# HMAC key for the session cookie and the site gate. Required in production.
# Locally, if this is empty, a secret is written to data/.session-secret.
SESSION_SECRET=

# Password in front of the whole site, including the shop desk.
# Leave this empty on this computer so the preview stays open.
SITE_PASSWORD=

# Public origin, with no trailing slash.
RITZY_BASE_URL=http://127.0.0.1:4765

# Set to 1 when the site is reached over HTTPS.
# Leave unset for the local http preview so the sign-in cookie still works.
# RITZY_COOKIE_SECURE=1

# Where the SQLite file and photos live. On Fly this is the volume mount.
# RITZY_DATA_DIR=data

# sqlite and local are the working defaults. Other names are refused until a driver exists.
RITZY_DATABASE_DRIVER=sqlite
RITZY_FILE_DRIVER=local

# Largest accepted photo, in bytes. Default is 20MB. At most 8 photos at a time.
# RITZY_MAX_UPLOAD_BYTES=20971520

# Email stays off. Nothing is sent.
# To plug in a provider later, set the driver to webhook and give it a URL.
RITZY_EMAIL_DRIVER=off
# RITZY_EMAIL_WEBHOOK_URL=
# RITZY_NOTIFY_EMAIL=
